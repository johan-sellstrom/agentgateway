# haps-guard config for the lab. deploy.sh fills in the placeholders and stores the result in Secret
# Manager (haps-guard-config) because the Redis URL carries the Memorystore AUTH string.
# Cloud Run mounts each secret in its own directory; relative paths resolve against
# /etc/haps-guard/config, so the trust anchors are one level up.
listen: 0.0.0.0:8080
audience:
  id: did:web:${GATEWAY_HOST}
  name: HAPS lab gateway
agent:
  id: did:web:agent.haps-lab.invalid
  name: HAPS lab agent
# TEST FIXTURES: a Presence Provider key generated by `haps-mint init`. Replace with the real
# iProov Presence Provider issuer and JWKS when available.
issuers:
  did:web:test-pp.haps-lab.invalid: ../trust-pp/pp-test.jwks.json
# Nothing is served here: there is no Presence Provider in the lab. The URL only appears in
# the -32042 elicitation the gateway returns.
elicitationUrl: https://test-pp.haps-lab.invalid/approve
clockSkewSeconds: 60
challengeTtlSeconds: 300
certification:
  certifiers:
    did:web:test-certifier.haps-lab.invalid: ../trust-certifier/certifier-test.jwks.json
  providers:
    did:web:test-pp.haps-lab.invalid: test-pp
  # The PCC is provisioned, so credentials can reference it without embedding it.
  provisioned:
    https://test-certifier.haps-lab.invalid/pcc/test-pp: ../trust-pcc/pcc-test.jws
state:
  backend: redis
  url: ${REDIS_URL}
  keyPrefix: "haps-guard:{haps}:"
  # Memorystore Basic tier has no replica, so nothing can acknowledge a spend. Production:
  # Standard tier (or Cluster) with minReplicaAcks: 1.
  minReplicaAcks: 0
tools:
  # Plain exact binding: the approval must name exactly these arguments.
  transfer:
    actionType: payment.transfer
    minLevel: HAPS-PoHP-2
    binding: exact
  # The gateway issues the challenge; the use is spent only once the tool succeeds.
  rotate_key:
    actionType: admin.rotate_key
    minLevel: HAPS-PoHP-2
    challengeMode: true
    spendOn: success
    reservationTtlSeconds: 60
    display:
      title: "Rotate a signing key"
      summary: "{agent} asks {audience} to call {tool} with {arguments}"
  # Shows that the credential is stripped before the upstream sees _meta.
  inspect_meta:
    actionType: demo.inspect_meta
    minLevel: HAPS-PoHP-2
